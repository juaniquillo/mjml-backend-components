{
    "name": "juaniquillo/mjml-backend-components",
    "description": "Backend components for MJML",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Juaniquillo",
            "role": "Developer",
            "email": "juaniquillo@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "juaniquillo/base-backend-component": "^0.1.0",
        "symfony/process": "^7.0|^8.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.0",
        "rector/rector": "^2.0",
        "laravel/pint": "^1.0",
        "phpstan/phpstan": "^2.0"
    },
    "suggest": {
        "ext-v8js": "Allows hyper-fast, in-memory MJML rendering directly inside the PHP process without spawning Node shell commands."
    },
    "autoload": {
        "psr-4": {
            "Juaniquillo\\MjmlBackendComponents\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Juaniquillo\\MjmlBackendComponents\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/pint --parallel"
        ],
        "lint:check": [
            "vendor/bin/pint --parallel --test"
        ],
        "analyse": [
            "vendor/bin/phpstan analyse --memory-limit=1G"
        ],
        "rector": [
            "vendor/bin/rector process"
        ],
        "rector:check": [
            "vendor/bin/rector process --dry-run"
        ],
        "test:unit": [
            "vendor/bin/pest"
        ],
        "test:ci": [
            "vendor/bin/pest --ci"
        ],
        "qa": [
            "@analyse",
            "@rector:check",
            "@lint",
            "@test:unit"
        ],
        "qa:ci": [
            "@analyse",
            "@rector:check",
            "@lint:check",
            "@test:ci"
        ]
    }
}
